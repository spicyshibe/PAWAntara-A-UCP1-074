<!-- File: views/index.ejs -->
<%- include('partials/navbar') %>

<section class="bg-white rounded-lg shadow-md p-8 text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-4">Selamat Datang di Toko Sembako Ariesta</h2>
    <p class="text-gray-600 mb-6">Menyediakan kebutuhan pokok rumah tangga Anda dengan harga terbaik dan stok selalu *update*.</p>
    <a href="/produk" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">Lihat Semua Produk</a>
</section>

<section>
    <h3 class="text-2xl font-bold text-gray-800 mb-4">Produk Pilihan</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% products.forEach(product => { %>
            <article class="bg-white border rounded-lg p-4 shadow hover:shadow-lg transition">
                <h4 class="text-lg font-semibold text-gray-800"><%= product.name %></h4>
                <p class="text-sm text-gray-500 mb-2">Kategori: <%= product.category %></p>
                <p class="text-xl font-bold text-blue-600 mb-4">Rp <%= product.price.toLocaleString('id-ID') %></p>
                <a href="/produk/<%= product.id %>" class="text-blue-500 hover:underline">Lihat Detail &rarr;</a>
            </article>
        <% }) %>
    </div>
</section>

<%- include('partials/footer') %>