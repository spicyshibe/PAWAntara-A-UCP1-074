<!-- File: views/detail.ejs -->
<%- include('partials/navbar') %>

<section class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-8">
    <% if (error) { %>
        <div class="text-center">
            <h2 class="text-2xl font-bold text-red-600 mb-4"><%= error %></h2>
            <p class="mb-4">Maaf, produk yang Anda cari tidak tersedia di sistem kami.</p>
            <a href="/produk" class="text-blue-600 hover:underline">&larr; Kembali ke Daftar Produk</a>
        </div>
    <% } else { %>
        <h2 class="text-3xl font-bold text-gray-800 mb-2"><%= product.name %></h2>
        <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded mb-4"><%= product.category %></span>
        
        <div class="border-t border-b py-4 my-4">
            <p class="text-2xl font-bold text-blue-600 mb-2">Rp <%= product.price.toLocaleString('id-ID') %></p>
            <p class="text-gray-600">Sisa Stok: <span class="font-semibold text-gray-800"><%= product.stock %></span></p>
        </div>

        <p class="text-gray-600 mb-6">Gunakan fitur Tanya AI jika Anda memiliki pertanyaan lebih lanjut mengenai pengiriman atau detail produk ini.</p>
        
        <div class="flex gap-4">
            <a href="/produk" class="border border-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-50">&larr; Kembali</a>
            <a href="/tanya-ai" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Tanya AI</a>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>