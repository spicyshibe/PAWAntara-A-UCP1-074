<!-- File: views/partials/navbar.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toko Sembako Ariesta</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex flex-col min-h-screen">
    <header class="bg-blue-600 text-white shadow-md">
        <nav class="container mx-auto p-4 flex justify-between items-center">
            <h1 class="text-xl font-bold"><a href="/">Toko Ariesta</a></h1>
            
            <!-- Menu Desktop -->
            <ul class="hidden md:flex space-x-6">
                <li><a href="/" class="hover:text-blue-200">Beranda</a></li>
                <li><a href="/produk" class="hover:text-blue-200">Produk</a></li>
                <li><a href="/tanya-ai" class="hover:text-blue-200">Tanya AI</a></li>
            </ul>

            <!-- Tombol Hamburger Mobile -->
            <button id="hamburgerBtn" class="md:hidden focus:outline-none" aria-label="Buka Menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </nav>

        <!-- Menu Mobile -->
        <div id="mobileMenu" class="hidden md:hidden bg-blue-700 p-4">
            <ul class="flex flex-col space-y-4">
                <li><a href="/" class="block hover:text-blue-200">Beranda</a></li>
                <li><a href="/produk" class="block hover:text-blue-200">Produk</a></li>
                <li><a href="/tanya-ai" class="block hover:text-blue-200">Tanya AI</a></li>
            </ul>
        </div>
    </header>

    <script>
        const btn = document.getElementById('hamburgerBtn');
        const menu = document.getElementById('mobileMenu');
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
    </script>
    <main class="flex-grow container mx-auto p-4 md:p-8">